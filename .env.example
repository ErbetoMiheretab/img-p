# =============================================================================
# DEVELOPMENT ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values
# =============================================================================

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
# Redis connection URL for development (no password in dev)
REDIS_URL=redis://redis:6379/0

# Redis password for production (set this in .env.production)
# REDIS_PASSWORD=your_secure_redis_password_here

# -----------------------------------------------------------------------------
# Service URLs
# -----------------------------------------------------------------------------
# Image service URL (used by gateway to communicate with image service)
IMAGE_SERVICE_URL=http://image_service:8001

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
# Environment: development, staging, production
ENVIRONMENT=development

# Log level: debug, info, warning, error, critical
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Port Configuration (for local development outside Docker)
# -----------------------------------------------------------------------------
# Gateway service port
GATEWAY_PORT=8000

# Image service port
IMAGE_SERVICE_PORT=8001

# Redis port (mapped to host)
REDIS_PORT=6381

# Flower monitoring port
FLOWER_PORT=5555

# -----------------------------------------------------------------------------
# Celery Configuration
# -----------------------------------------------------------------------------
# Celery worker concurrency (number of worker processes)
CELERY_WORKER_CONCURRENCY=4

# Celery log level
CELERY_LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Flower Monitoring (Production)
# -----------------------------------------------------------------------------
# Flower basic authentication credentials (required for production)
# FLOWER_USER=admin
# FLOWER_PASSWORD=your_secure_flower_password_here

# -----------------------------------------------------------------------------
# Image Processing Configuration
# -----------------------------------------------------------------------------
# Maximum upload file size in MB
MAX_UPLOAD_SIZE_MB=10

# Supported image formats (comma-separated)
SUPPORTED_FORMATS=jpg,jpeg,png,gif,bmp,webp

# -----------------------------------------------------------------------------
# OCR Configuration
# -----------------------------------------------------------------------------
# Tesseract language (default: eng for English)
TESSERACT_LANG=eng

# OCR timeout in seconds
OCR_TIMEOUT=30

# -----------------------------------------------------------------------------
# Performance & Limits
# -----------------------------------------------------------------------------
# Maximum concurrent image processing tasks
MAX_CONCURRENT_TASKS=10

# Task timeout in seconds
TASK_TIMEOUT=300

# Request timeout in seconds
REQUEST_TIMEOUT=60
